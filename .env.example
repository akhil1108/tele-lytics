# ============================================================================
# Call Analytics — example environment. Copy to .env and fill in.
# Never commit a real .env.
# ============================================================================

# ---- Core ----
APP_ENV=development
APP_NAME="Call Analytics"
LOG_LEVEL=INFO
# Public base URL of the API, used to build absolute media links.
API_BASE_URL=http://localhost:8000

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
DEVICE_TOKEN_TTL_DAYS=180
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# Postgres in docker-compose; SQLite works for local dev and tests.
DATABASE_URL=postgresql+asyncpg://calls:calls@localhost:5432/callanalytics
# DATABASE_URL=sqlite+aiosqlite:///./data/callanalytics.sqlite3

# ---- Object storage for call recordings ----
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Speech-to-text (stage 1 model) ----
# shared_model | mock
# `shared_model` posts audio to the endpoint below. See docs/STT_CONTRACT.md.
STT_PROVIDER=mock
STT_ENDPOINT_URL=
STT_API_KEY=
STT_MODEL=
STT_TIMEOUT_SECONDS=900
STT_LANGUAGE_HINT=en-IN
# Set true when the shared model returns tone/emotion per segment.
STT_RETURNS_TONE=true

# ---- Analysis LLM (stage 2 model) ----
# claude | mock
ANALYSIS_PROVIDER=claude
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-opus-5
ANALYSIS_EFFORT=high
ANALYSIS_MAX_TOKENS=16000

# ---- Pipeline worker ----
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=4
WORKER_MAX_ATTEMPTS=3
# Hard cap on an uploaded recording, in megabytes.
MAX_RECORDING_MB=200

# ---- Retention ----
# Recordings older than this are purged by the retention job (0 disables).
DEFAULT_RETENTION_DAYS=90

# ---- Web dashboard (web/.env.local) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Mobile app (mobile/.env) ----
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
