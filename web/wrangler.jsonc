{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tele-lytics-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // NEXT_PUBLIC_* vars are inlined into the client bundle at build time by
  // Next.js itself (web/.env.production), not read from here at runtime —
  // this entry exists for any server-side code path that reads process.env
  // directly, and to keep the deployed value visible/auditable in one place.
  "vars": {
    "NEXT_PUBLIC_API_BASE_URL": "https://tele-lytics-api.mathakhilesh.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
