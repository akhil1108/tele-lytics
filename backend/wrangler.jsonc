{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tele-lytics-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // WORKER_TICK_SECRET must match the backend's own env var of the same
  // name (see .env.example) — set as a Worker secret, not a plaintext var:
  //   npx wrangler secret put WORKER_TICK_SECRET
  "containers": [
    {
      "class_name": "Backend",
      "image": "./Dockerfile",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BACKEND", "class_name": "Backend" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Backend"] }
  ],
  "observability": {
    "enabled": true
  }
}
