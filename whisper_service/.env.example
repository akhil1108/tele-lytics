# Copy to .env, or set these as real environment variables.

WHISPER_MODEL=openai/whisper-large-v3-turbo
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
EMOTION_MODEL=superb/wav2vec2-base-superb-er

# Required for the gated diarisation models — accept terms at both while
# logged in before this token can download them:
#   huggingface.co/pyannote/speaker-diarization-3.1
#   huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=

# Required for non-English -> English translation (client.audio.translations,
# model whisper-1). Only needed if you'll send calls with a non-English
# language hint; get a key at platform.openai.com/api-keys.
OPENAI_API_KEY=

# Optional: require `Authorization: Bearer <this>` on requests. Set the same
# value as the main repo's STT_API_KEY.
SERVICE_API_KEY=

PORT=8001
# auto | cpu | cuda | mps
DEVICE=auto
